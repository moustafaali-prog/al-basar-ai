# Al-Basar AI v3 — Supabase cloud sync (optional)
# Copy to `.env.local` and paste the project keys from Supabase → Project Settings → API.
# Leave empty to keep the app 100% offline-first; the local queue keeps working.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
